{
  "name": "ishosfactory",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "DEPLOY_TARGET=vercel astro dev --host 0.0.0.0 --port 4321",
    "dev:cloudflare": "astro dev",
    "dev:lan": "DEPLOY_TARGET=vercel astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "build:vercel": "DEPLOY_TARGET=vercel astro build",
    "deploy": "pnpm run build:cloudflare && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:store-boundary": "node scripts/check-store-boundaries.mjs",
    "audit": "pnpm audit --audit-level high",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,astro,css}\"",
    "test:e2e": "playwright test",
    "audit:fix": "pnpm audit --fix",
    "lint": "astro check && tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "generate:api-types": "openapi-typescript ../ishosBackEnd/api/openapi.yaml -o src/types/api-generated.ts",
    "prepare": "husky",
    "icons:subset": "node scripts/build-icon-subset.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/svelte": "^9.1.6",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify/svelte": "^5.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "daisyui": "^5.7.50",
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "motion": "^12.43.0",
    "svelte": "^5.57.3",
    "svelte-echarts": "^1.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/vercel": "^11.0.22",
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.154",
    "@iconify-json/proicons": "^1.2.21",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "1.65.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "lint-staged": {
    "*.{ts,js,svelte,astro,json}": [
      "prettier --write"
    ]
  }
}
