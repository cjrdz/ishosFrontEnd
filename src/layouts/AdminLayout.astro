---
import "../styles/global.css";
import { inlineScript } from "@shared/csp/inline-script";
import adminThemeSource from "./inline/admin-theme.js?raw";

interface Props {
  title: string;
}

const { title } = Astro.props as Props;

// Inline so the theme applies before first paint; hash registered with the CSP.
const adminThemeScript = await inlineScript(Astro, adminThemeSource);
---

<!doctype html>
<html lang="es" data-theme="night" class="bg-base-200">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="IshosFactory Admin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline set:html={adminThemeScript} />
  </head>
  <body class="bg-base-200 text-base-content min-h-screen flex flex-col">
    <main class="container mx-auto px-4 py-8 flex-1 w-full">
      <slot />
    </main>
  </body>
</html>
