---
import StoreLayout from "../../layouts/StoreLayout.astro";
// Island entries import the component file directly, not a feature barrel:
// Astro bundles the imported module, so a barrel would ship every export.
import OrderTracking from "@features/orders/components/public/OrderTracking.svelte";
---

<StoreLayout title="Seguir mi orden · Isho's">
  <section class="container mx-auto px-4 pt-6 pb-8 md:pt-8">
    <OrderTracking client:load />
  </section>
</StoreLayout>
