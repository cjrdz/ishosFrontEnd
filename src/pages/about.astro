---
import StoreLayout from "../layouts/StoreLayout.astro";
import Icon from "@shared/components/AppIcon.svelte";
import StoreHoursCard from "@features/catalog/components/StoreHoursCard.svelte";
import StoreLocationsList from "@features/catalog/components/StoreLocationsList.svelte";
import BrandStamp from "@shared/components/BrandStamp.svelte";
import {
  BRAND_MISSION,
  BRAND_PHONE_DISPLAY as PHONE_DISPLAY,
  BRAND_PHONE_TEL as PHONE_TEL,
  BRAND_SOCIALS as socials,
  BRAND_WHATSAPP_URL as WHATSAPP,
} from "@shared/lib/brand";

const values = [
  {
    icon: "lucide:shield-check",
    title: "Calidad",
    text: "Solo los mejores ingredientes llegan a nuestras recetas.",
  },
  {
    icon: "lucide:heart",
    title: "Tradición",
    text: "Desde 2021 llevando sabores auténticos a cada familia.",
  },
  {
    icon: "lucide:sparkles",
    title: "Pasión",
    text: "Cada helado es hecho con dedicación y amor por lo que hacemos.",
  },
];
---

<StoreLayout title="Nosotros · Isho's Gelatos & Sorbetes">
  <div
    class="mx-auto max-w-6xl space-y-14 px-4 pb-16 pt-6 md:space-y-20 md:pt-10"
  >
    <section
      class="grid items-center gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
    >
      <div class="space-y-5">
        <p class="brand-label">
          <span class="brand-label__num">19</span>GELATOS &amp; SORBETES<span
            class="brand-label__num">68</span
          >
        </p>
        <h1
          class="font-display font-bold text-6xl leading-[0.95] text-head md:text-7xl"
        >
          Gelatos y sorbetes <span class="marker">artesanales</span>
        </h1>
        <p class="text-lg">{BRAND_MISSION}</p>
        <p class="text-ink-muted">
          Desde 2021 en Ahuachapán: preparamos cada bola con los mejores
          ingredientes y fruta fresca del mercado.
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="Lo que nos distingue">
          <li
            class="badge badge-lg min-h-9 gap-1.5 border-base-300 bg-base-100 font-medium"
          >
            <Icon
              icon="lucide:sparkles"
              class="size-4 text-primary"
              aria-hidden="true"
            />Artesanal
          </li>
          <li
            class="badge badge-lg min-h-9 gap-1.5 border-base-300 bg-base-100 font-medium"
          >
            <Icon
              icon="lucide:leaf"
              class="size-4 text-primary"
              aria-hidden="true"
            />Ingredientes naturales
          </li>
          <li
            class="badge badge-lg min-h-9 gap-1.5 border-base-300 bg-base-100 font-medium"
          >
            <Icon
              icon="lucide:map-pin"
              class="size-4 text-primary"
              aria-hidden="true"
            />Hecho en El Salvador
          </li>
        </ul>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href="/menu" class="btn btn-primary btn-lg rounded-full"
            >Ver el menú</a
          >
          <a
            href="#sucursales"
            class="btn btn-outline btn-lg rounded-full border-2 border-head text-head"
            >Cómo llegar</a
          >
        </div>
      </div>

      <figure class="about-art rays rays--cream">
        <img
          src="/images/brand/frutera-dia.webp"
          alt="Ilustración de la frutera en moto con su canasta de fruta fresca"
          width="760"
          height="706"
          class="art-day"
        />
        <img
          src="/images/brand/frutera-noche.webp"
          alt="Ilustración de la frutera en moto con su canasta de fruta fresca"
          width="760"
          height="706"
          class="art-night"
        />
        <BrandStamp size={96} class="about-stamp" />
      </figure>
    </section>

    <section aria-labelledby="valores-title" id="valores">
      <h2
        id="valores-title"
        class="mb-5 font-display font-bold text-4xl text-head md:text-5xl"
      >
        Lo que nos define
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          values.map((value) => (
            <article class="rounded-box border border-base-300 bg-base-100 p-5">
              <span class="mb-3 grid size-11 place-items-center rounded-full bg-pink-tint text-head">
                <Icon icon={value.icon} class="size-5" aria-hidden="true" />
              </span>
              <h3 class="mb-1 text-lg font-bold">{value.title}</h3>
              <p class="text-base-content/75">{value.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="contacto-title" id="contacto">
      <h2
        id="contacto-title"
        class="mb-5 font-display font-bold text-4xl text-head md:text-5xl"
      >
        Contáctanos
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div
          class="flex flex-col gap-4 rounded-box border border-base-300 bg-base-100 p-5 md:p-6"
        >
          <div>
            <div class="mb-2 flex items-center gap-2">
              <Icon
                icon="lucide:phone"
                class="size-5 text-head"
                aria-hidden="true"
              />
              <h3 class="text-lg font-bold">Escríbenos o llámanos</h3>
            </div>
            <p class="text-base-content/75">
              Pedidos especiales, eventos o dudas sobre tu orden: respondemos
              por WhatsApp.
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href={WHATSAPP}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary rounded-full"
            >
              <Icon icon="mdi:whatsapp" class="size-5" aria-hidden="true" />
              WhatsApp
            </a>
            <a href={PHONE_TEL} class="btn btn-outline rounded-full">
              <Icon
                icon="lucide:phone-call"
                class="size-4"
                aria-hidden="true"
              />
              {PHONE_DISPLAY}
            </a>
          </div>

          <div class="border-t border-base-300 pt-4">
            <h3 class="mb-2 font-semibold">Síguenos</h3>
            <ul class="grid gap-2 sm:grid-cols-3">
              {
                socials.map((social) => (
                  <li>
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex min-h-11 items-center gap-2 rounded-field border border-base-300 px-3 py-2 transition-colors hover:border-head hover:bg-pink-tint"
                    >
                      <Icon
                        icon={social.icon}
                        class="size-5 shrink-0"
                        aria-hidden="true"
                      />
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold">
                          {social.label}
                        </span>
                        <span class="block truncate text-xs text-ink-muted">
                          {social.handle}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <StoreHoursCard client:idle headingLevel="h3" />
      </div>
    </section>

    <section
      aria-labelledby="sucursales-title"
      id="sucursales"
      class="scroll-mt-24"
    >
      <h2
        id="sucursales-title"
        class="mb-1 font-display font-bold text-4xl text-head md:text-5xl"
      >
        Nuestras sucursales
      </h2>
      <p class="mb-5 text-base-content/75">
        Encuéntranos en Ahuachapán, El Salvador. Cada sucursal tiene su propio
        WhatsApp para pedidos especiales y dudas.
      </p>
      <StoreLocationsList client:idle variant="maps" />
    </section>
  </div>
</StoreLayout>

<style>
  .about-art {
    --rays-at: 50% 115%;
    position: relative;
    margin: 0;
    display: flex;
    justify-content: center;
    padding: 2rem 1rem 0;
    border-radius: 1.75rem;
    overflow: hidden;
  }
  .about-art img {
    width: min(100%, 22rem);
    height: auto;
  }
  .about-art :global(.about-stamp) {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    transform: rotate(8deg);
  }
</style>
