---
import StoreLayout from "../layouts/StoreLayout.astro";
import Icon from "@shared/components/AppIcon.svelte";
import "../styles/about.css";
---

<StoreLayout title="IshosFactory - Nosotros">
  <div class="space-y-0">
    {/* ══════════════════════════════════════════ */}
    {/* ── HERO SECTION ── */}
    {/* ══════════════════════════════════════════ */}
    <section class="relative overflow-hidden px-4 pt-8 pb-16 md:pt-12 md:pb-20">
      {/* Background blobs */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div
          class="hero-blob-teal absolute -top-24 -left-24 w-96 h-96 rounded-full blur-3xl"
          style="background: var(--ishos-teal);"
        >
        </div>
        <div
          class="hero-blob-pink absolute -bottom-16 -right-16 w-80 h-80 rounded-full blur-3xl"
          style="background: var(--ishos-pink);"
        >
        </div>
        <div class="stripe-bg absolute inset-0 opacity-40"></div>
      </div>

      <div class="relative max-w-3xl mx-auto text-center fade-up fade-up-1">
        {/* Pre-title pill */}
        <div
          class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest mb-5 border"
          style="background: var(--about-pill-teal-bg); border-color: color-mix(in srgb, var(--ishos-teal) 30%, transparent); color: var(--ishos-teal);"
        >
          <span
            class="w-1.5 h-1.5 rounded-full inline-block"
            style="background: var(--ishos-teal);"></span>
          Desde 2021
        </div>

        <h1
          class="text-5xl md:text-6xl font-extrabold tracking-tight mb-3 leading-tight"
        >
          <span style="color: var(--ishos-teal);">Isho's</span>
          <span class="text-base-content"> Factory</span>
        </h1>
        <p
          class="text-base-content/60 text-sm font-bold uppercase tracking-[0.25em] mb-10"
        >
          Gelatos &amp; Sorbetes Artesanales
        </p>

        {/* Hero card with animated gradient border */}
        <div class="hero-card-border shadow-2xl fade-up fade-up-2">
          <div
            class="bg-base-100 rounded-3xl p-7 md:p-10 relative overflow-hidden"
          >
            {/* Inner accent bar */}
            <div
              class="absolute top-0 left-0 right-0 h-1 rounded-t-3xl"
              style="background: linear-gradient(90deg, var(--ishos-teal), var(--ishos-pink), var(--ishos-yellow));"
            >
            </div>

            <p
              class="text-lg md:text-xl text-base-content/80 leading-relaxed font-medium mb-8"
            >
              Isho's Factory ha sido sinónimo de
              <strong style="color: var(--ishos-teal);">tradición</strong> y
              <strong style="color: var(--ishos-maroon);">calidad</strong>
              en El Salvador. Nuestros helados artesanales son preparados con los
              mejores ingredientes y mucho amor. Cada bola de helado cuenta una historia
              de sabor auténtico y dedicación. Visítanos y descubre por qué generaciones
              de salvadoreños nos eligen.
            </p>

            <div class="flex flex-wrap gap-3 justify-center">
              <span
                class="inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold border-2"
                style="border-color: var(--ishos-teal); color: var(--ishos-teal);"
              >
                ✨ Artesanal
              </span>
              <span
                class="inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold border-2"
                style="border-color: var(--ishos-maroon); color: var(--ishos-maroon);"
              >
                🍃 Ingredientes Naturales
              </span>
              <span
                class="inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold border-2 text-base-content/70"
                style="border-color: color-mix(in srgb, var(--ishos-yellow) 80%, #aaa);"
              >
                🇸🇻 Hecho en El Salvador
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Wave divider */}
    <div class="wave-divider -mt-2" style="color: var(--ishos-teal);">
      <svg
        viewBox="0 0 1440 60"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        style="height:40px; width:100%;"
      >
        <path
          d="M0,30 C240,60 480,0 720,30 C960,60 1200,0 1440,30 L1440,60 L0,60 Z"
          fill="var(--about-wave-fill)"></path>
      </svg>
    </div>

    {/* ══════════════════════════════════════════ */}
    {/* ── VALUES SECTION ── */}
    {/* ══════════════════════════════════════════ */}
    <section class="px-4 py-14 md:py-18">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 fade-up fade-up-2">
          <div
            class="inline-block rounded-2xl px-4 py-1 text-xs font-bold uppercase tracking-widest mb-3"
            style="background: var(--about-pill-maroon-bg); color: var(--ishos-maroon);"
          >
            Nuestra Esencia
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-base-content">
            Lo que nos <span style="color: var(--ishos-teal);">define</span>
          </h2>
          <p class="text-base-content/60 mt-2 font-medium">
            Los pilares de nuestra marca
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 fade-up fade-up-3">
          {/* Calidad */}
          <div
            class="value-card bg-base-100 border border-base-200 rounded-2xl text-center transition-all duration-300 overflow-hidden group"
          >
            <div class="h-1.5 w-full" style="background: var(--ishos-teal);">
            </div>
            <div class="p-8">
              <div
                class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center"
                style="background: var(--about-icon-teal-bg);"
              >
                <Icon
                  icon="lucide:shield-check"
                  class="w-7 h-7"
                  style="color: var(--ishos-teal);"
                />
              </div>
              <h3 class="text-xl font-extrabold mb-2 text-base-content">
                Calidad
              </h3>
              <p class="text-base-content/70 text-sm leading-relaxed">
                Solo los mejores ingredientes llegan a nuestras recetas.
              </p>
            </div>
          </div>

          {/* Tradición — featured / center */}
          <div
            class="value-card rounded-2xl text-center transition-all duration-300 overflow-hidden group relative shadow-lg"
            style="background: linear-gradient(145deg, var(--ishos-maroon), color-mix(in srgb, var(--ishos-maroon) 80%, black));"
          >
            <div class="h-1.5 w-full" style="background: var(--ishos-pink);">
            </div>
            <div class="p-8">
              <div
                class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center"
                style="background: var(--about-icon-pink-bg);"
              >
                <Icon
                  icon="lucide:clock"
                  class="w-7 h-7"
                  style="color: var(--ishos-pink);"
                />
              </div>
              <h3
                class="text-xl font-extrabold mb-2"
                style="color: var(--ishos-yellow);"
              >
                Tradición
              </h3>
              <p
                class="text-sm leading-relaxed"
                style="color: color-mix(in srgb, white 70%, var(--ishos-pink));"
              >
                Más de 4 años llevando sabores auténticos a cada familia.
              </p>
            </div>
          </div>

          {/* Pasión */}
          <div
            class="value-card bg-base-100 border border-base-200 rounded-2xl text-center transition-all duration-300 overflow-hidden group"
          >
            <div class="h-1.5 w-full" style="background: var(--ishos-pink);">
            </div>
            <div class="p-8">
              <div
                class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center"
                style="background: var(--about-icon-pink-bg);"
              >
                <Icon
                  icon="lucide:heart"
                  class="w-7 h-7"
                  style="color: var(--ishos-maroon);"
                />
              </div>
              <h3 class="text-xl font-extrabold mb-2 text-base-content">
                Pasión
              </h3>
              <p class="text-base-content/70 text-sm leading-relaxed">
                Cada helado es hecho con dedicación y amor por lo que hacemos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════════════════════════════════ */}
    {/* ── CONTACT SECTION ── */}
    {/* ══════════════════════════════════════════ */}
    <section class="px-4 py-14 md:py-18 relative overflow-hidden">
      {/* Subtle teal wash background */}
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: var(--about-contact-wash);"
      >
      </div>

      <div class="max-w-5xl mx-auto relative">
        <div class="text-center mb-10 fade-up fade-up-3">
          <div
            class="inline-block rounded-2xl px-4 py-1 text-xs font-bold uppercase tracking-widest mb-3"
            style="background: var(--about-pill-teal-bg); color: var(--ishos-teal);"
          >
            Contáctanos
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-base-content">
            📍 Estamos <span style="color: var(--ishos-teal);">aquí</span> para ti
          </h2>
          <p class="text-base-content/60 mt-2 font-medium">
            Encuéntranos o comunícate con nosotros.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 fade-up fade-up-4">
          {/* Location */}
          <div
            class="bg-base-100 border border-base-200 rounded-2xl p-7 text-center hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
          >
            <div
              class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center"
              style="background: var(--about-icon-teal-bg);"
            >
              <Icon
                icon="lucide:map-pin"
                class="w-7 h-7"
                style="color: var(--ishos-teal);"
              />
            </div>
            <h3 class="text-lg font-extrabold mb-2 text-base-content">
              Visítanos
            </h3>
            <p class="text-base-content/60 text-sm leading-relaxed">
              Ahuachapán<br />El Salvador
            </p>
          </div>

          {/* Phone / WhatsApp */}
          <div
            class="rounded-2xl p-7 text-center hover:shadow-xl hover:-translate-y-1 transition-all duration-300 shadow-md"
            style="background: linear-gradient(145deg, var(--ishos-teal), color-mix(in srgb, var(--ishos-teal) 75%, var(--ishos-mint)));"
          >
            <div
              class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center bg-white/20"
            >
              <Icon icon="lucide:phone" class="w-7 h-7 text-white" />
            </div>
            <h3 class="text-lg font-extrabold mb-4 text-white phone-card-text">
              Llámanos
            </h3>
            <div class="flex flex-col gap-3">
              <a
                href="tel:+50376454347"
                class="flex items-center justify-center gap-2 rounded-full py-2.5 px-5 text-sm font-bold bg-white/20 hover:bg-white/30 text-white transition-colors phone-card-text"
              >
                <Icon icon="lucide:phone-call" class="w-4 h-4" /> Llamar
              </a>
              <a
                href="https://wa.me/50376454347"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 rounded-full py-2.5 px-5 text-sm font-bold transition-opacity hover:opacity-90 phone-card-text"
                style="background: var(--ishos-maroon); color: white;"
              >
                <Icon icon="mdi:whatsapp" class="w-4 h-4" /> WhatsApp
              </a>
            </div>
          </div>

          {/* Schedule */}
          <div
            class="bg-base-100 border border-base-200 rounded-2xl p-7 text-center hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
          >
            <div
              class="w-14 h-14 rounded-2xl mx-auto mb-4 flex items-center justify-center"
              style="background: var(--about-icon-pink-bg);"
            >
              <Icon
                icon="lucide:clock"
                class="w-7 h-7"
                style="color: var(--ishos-maroon);"
              />
            </div>
            <h3 class="text-lg font-extrabold mb-4 text-base-content">
              Horario
            </h3>
            <div class="space-y-2">
              <div
                class="flex justify-between items-center text-sm rounded-xl px-4 py-2.5"
                style="background: var(--about-schedule-bg);"
              >
                <span class="font-bold text-base-content/80">Lun – Vie</span>
                <span class="text-base-content/65">10:30 AM – 6:30 PM</span>
              </div>
              <div
                class="flex justify-between items-center text-sm rounded-xl px-4 py-2.5"
                style="background: var(--about-schedule-bg);"
              >
                <span class="font-bold text-base-content/80">Domingo</span>
                <span class="text-base-content/65">10:30 AM – 6:30 PM</span>
              </div>
            </div>
          </div>
        </div>

        {/* ── Social Media ── */}
        <div class="mt-10 fade-up fade-up-5">
          <p
            class="text-center text-xs font-bold uppercase tracking-[0.2em] text-base-content/60 mb-5"
          >
            Síguenos en Redes Sociales
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            {/* Instagram */}
            <a
              href="https://www.instagram.com/ishos_factory/?hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill flex items-center gap-2.5 bg-base-100 border border-base-200 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300"
              aria-label="Instagram"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <defs>
                  <linearGradient
                    id="ig-grad2"
                    x1="0%"
                    y1="100%"
                    x2="100%"
                    y2="0%"
                  >
                    <stop offset="0%" style="stop-color:#f09433"></stop>
                    <stop offset="50%" style="stop-color:#dc2743"></stop>
                    <stop offset="100%" style="stop-color:#bc1888"></stop>
                  </linearGradient>
                </defs>
                <rect
                  x="2"
                  y="2"
                  width="20"
                  height="20"
                  rx="5"
                  ry="5"
                  stroke="url(#ig-grad2)"
                  stroke-width="2"
                  fill="none"></rect>
                <circle
                  cx="12"
                  cy="12"
                  r="4"
                  stroke="url(#ig-grad2)"
                  stroke-width="2"
                  fill="none"></circle>
                <circle cx="17.5" cy="6.5" r="1" fill="url(#ig-grad2)"></circle>
              </svg>
              <span style="color:#E4405F;">Instagram</span>
            </a>

            {/* Facebook */}
            <a
              href="https://www.facebook.com/ishosfactory/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill flex items-center gap-2.5 bg-base-100 border border-base-200 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300"
              aria-label="Facebook"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="#1877F2"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.874v2.25h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
                ></path>
              </svg>
              <span style="color:#1877F2;">Facebook</span>
            </a>

            {/* TikTok */}
            <a
              href="https://www.tiktok.com/@ishosfactory"
              target="_blank"
              rel="noopener noreferrer"
              class="social-pill flex items-center gap-2.5 bg-base-100 border border-base-200 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300"
              aria-label="TikTok"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.27 8.27 0 004.84 1.55V6.79a4.85 4.85 0 01-1.07-.1z"
                  fill="currentColor"></path>
              </svg>
              <span class="text-base-content">TikTok</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ══════════════════════════════════════════ */}
    {/* ── LOCATIONS / MAPS ── */}
    {/* ══════════════════════════════════════════ */}
    <section class="px-4 py-14 md:py-18 pb-10">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10 fade-up fade-up-4">
          <div
            class="inline-block rounded-2xl px-4 py-1 text-xs font-bold uppercase tracking-widest mb-3"
            style="background: var(--about-pill-maroon-bg); color: var(--ishos-maroon);"
          >
            Sucursales
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-base-content">
            Nuestras <span style="color: var(--ishos-teal);">Sucursales</span>
          </h2>
          <p class="text-base-content/60 mt-2 font-medium">
            Encuéntranos en Ahuachapán, El Salvador.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 fade-up fade-up-5">
          {/* Sucursal 1 */}
          <div
            class="bg-base-100 border border-base-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 group"
          >
            {/* Card header accent */}
            <div class="px-5 pt-5 pb-3 flex items-center justify-between">
              <div>
                <h3
                  class="text-base font-extrabold flex items-center gap-2 text-base-content"
                >
                  <span style="color: var(--ishos-teal);">
                    <Icon icon="lucide:map-pin" class="w-4 h-4 inline" />
                  </span>
                  Isho's Sucursal 1
                </h3>
                <p class="text-base-content/60 text-xs mt-0.5">
                  Ahuachapán, El Salvador
                </p>
              </div>
              <a
                href="https://maps.google.com/?q=Isho%27s+Sucursal+1,+Ahuachap%C3%A1n,+El+Salvador"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold flex items-center gap-1 px-3 py-1.5 rounded-full border transition-colors hover:text-white hover:bg-[var(--ishos-teal)]"
                style="border-color: var(--ishos-teal); color: var(--ishos-teal);"
              >
                <Icon icon="lucide:external-link" class="w-3 h-3" /> Abrir en Maps
              </a>
            </div>
            <div class="mx-5 rounded-xl overflow-hidden" style="height: 220px;">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6847.623198808501!2d-89.8518696249066!3d13.92355228648646!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f6297001f790639%3A0xa292396c664dfae0!2sIsho%E2%80%99s%20Sucursal%201!5e1!3m2!1ses!2ssv!4v1777132497595!5m2!1ses!2ssv"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mapa de Isho's Sucursal 1"></iframe>
            </div>
            <div class="p-5 pt-3">
              <a
                href="https://maps.google.com/?q=Isho%27s+Sucursal+1,+Ahuachap%C3%A1n,+El+Salvador"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full rounded-xl py-2.5 text-sm font-bold text-white transition-opacity hover:opacity-90"
                style="background: var(--ishos-teal);"
              >
                <Icon icon="lucide:navigation" class="w-4 h-4" /> Obtener Direcciones
              </a>
            </div>
          </div>

          {/* Sucursal 2 */}
          <div
            class="bg-base-100 border border-base-200 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 group"
          >
            <div class="px-5 pt-5 pb-3 flex items-center justify-between">
              <div>
                <h3
                  class="text-base font-extrabold flex items-center gap-2 text-base-content"
                >
                  <span style="color: var(--ishos-teal);">
                    <Icon icon="lucide:map-pin" class="w-4 h-4 inline" />
                  </span>
                  Isho's Sucursal 2
                </h3>
                <p class="text-base-content/60 text-xs mt-0.5">
                  Ahuachapán, El Salvador
                </p>
              </div>
              <a
                href="https://maps.app.goo.gl/bSYLeqagKbSW3wUh8"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold flex items-center gap-1 px-3 py-1.5 rounded-full border transition-colors hover:text-white hover:bg-[var(--ishos-teal)]"
                style="border-color: var(--ishos-teal); color: var(--ishos-teal);"
              >
                <Icon icon="lucide:external-link" class="w-3 h-3" /> Abrir en Maps
              </a>
            </div>
            <div class="mx-5 rounded-xl overflow-hidden" style="height: 220px;">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6847.705736039818!2d-89.8483311!3d13.920766299999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f6297004861f67d%3A0xfed9bfb450de212f!2sIsho%E2%80%99s%20sucursal%202!5e1!3m2!1ses!2ssv!4v1777132555390!5m2!1ses!2ssv"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mapa de Isho's Sucursal 2"></iframe>
            </div>
            <div class="p-5 pt-3">
              <a
                href="https://maps.app.goo.gl/bSYLeqagKbSW3wUh8"
                target="_blank"
