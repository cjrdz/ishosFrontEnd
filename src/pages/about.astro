---
import StoreLayout from "../layouts/StoreLayout.astro";
import Icon from "@shared/components/AppIcon.svelte";
import StoreHoursCard from "@features/catalog/components/StoreHoursCard.svelte";
import StoreLocationsList from "@features/catalog/components/StoreLocationsList.svelte";

const PHONE_DISPLAY = "7645-4347";
const PHONE_TEL = "tel:+50376454347";
const WHATSAPP = "https://wa.me/50376454347";

const values = [
  {
    icon: "lucide:shield-check",
    title: "Calidad",
    text: "Solo los mejores ingredientes llegan a nuestras recetas.",
  },
  {
    icon: "lucide:heart",
    title: "Tradición",
    text: "Desde 2021 llevando sabores auténticos a cada familia.",
  },
  {
    icon: "lucide:sparkles",
    title: "Pasión",
    text: "Cada helado es hecho con dedicación y amor por lo que hacemos.",
  },
];

const socials = [
  {
    icon: "lucide:instagram",
    label: "Instagram",
    handle: "@ishos_factory",
    href: "https://www.instagram.com/ishos_factory/",
  },
  {
    icon: "lucide:facebook",
    label: "Facebook",
    handle: "ishosfactory",
    href: "https://www.facebook.com/ishosfactory/",
  },
  {
    icon: "proicons:tiktok",
    label: "TikTok",
    handle: "@ishosfactory",
    href: "https://www.tiktok.com/@ishosfactory",
  },
];
---

<StoreLayout title="IshosFactory - Nosotros">
  <div
    class="mx-auto max-w-6xl space-y-14 px-4 pb-16 pt-6 md:space-y-20 md:pt-10"
  >
    <section
      class="grid items-center gap-8 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
    >
      <div class="space-y-5">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">
          Desde 2021 · Ahuachapán
        </p>
        <h1 class="font-display font-bold text-6xl leading-[0.95] md:text-7xl">
          Gelatos y sorbetes artesanales
        </h1>
        <p class="text-lg text-base-content/75">
          Isho's Factory es sinónimo de tradición y calidad en El Salvador.
          Preparamos nuestros helados con los mejores ingredientes y mucho
          cariño: cada bola cuenta una historia de sabor auténtico.
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="Lo que nos distingue">
          <li class="badge badge-lg gap-1.5 border-base-300 bg-base-100">
            <Icon
              icon="lucide:sparkles"
              class="size-4 text-primary"
              aria-hidden="true"
            />Artesanal
          </li>
          <li class="badge badge-lg gap-1.5 border-base-300 bg-base-100">
            <Icon
              icon="lucide:leaf"
              class="size-4 text-primary"
              aria-hidden="true"
            />Ingredientes naturales
          </li>
          <li class="badge badge-lg gap-1.5 border-base-300 bg-base-100">
            <Icon
              icon="lucide:map-pin"
              class="size-4 text-primary"
              aria-hidden="true"
            />Hecho en El Salvador
          </li>
        </ul>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href="/menu" class="btn btn-primary btn-lg rounded-full"
            >Ver el menú</a
          >
          <a href="#sucursales" class="btn btn-ghost btn-lg rounded-full"
            >Cómo llegar</a
          >
        </div>
      </div>

      <svg class="about-art" viewBox="0 0 240 240" aria-hidden="true">
        <circle
          cx="120"
          cy="120"
          r="110"
          fill="var(--color-primary)"
          opacity="0.12"></circle>
        <path
          d="M60 112h120l-12 92H72z"
          fill="var(--color-base-100)"
          stroke="var(--color-base-300)"
          stroke-width="3"></path>
        <circle cx="90" cy="96" r="34" fill="#f9b4da"></circle>
        <circle cx="150" cy="96" r="34" fill="#f9e9a9"></circle>
        <circle cx="120" cy="70" r="34" fill="#91e2d6"></circle>
        <rect
          x="88"
          y="140"
          width="64"
          height="18"
          rx="9"
          fill="var(--color-secondary)"></rect>
        <circle cx="108" cy="58" r="4" fill="#63001f"></circle>
        <circle cx="134" cy="80" r="4" fill="#63001f"></circle>
      </svg>
    </section>

    <section aria-labelledby="valores-title" id="valores">
      <h2
        id="valores-title"
        class="mb-5 font-display font-bold text-4xl md:text-5xl"
      >
        Lo que nos define
      </h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          values.map((value) => (
            <article class="rounded-box border border-base-300 bg-base-100 p-5">
              <span class="mb-3 grid size-11 place-items-center rounded-full bg-primary/10 text-primary">
                <Icon icon={value.icon} class="size-5" aria-hidden="true" />
              </span>
              <h3 class="mb-1 text-lg font-bold">{value.title}</h3>
              <p class="text-base-content/75">{value.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="contacto-title" id="contacto">
      <h2
        id="contacto-title"
        class="mb-5 font-display font-bold text-4xl md:text-5xl"
      >
        Contáctanos
      </h2>
      <div class="grid gap-4 md:grid-cols-2">
        <div
          class="flex flex-col gap-4 rounded-box border border-base-300 bg-base-100 p-5 md:p-6"
        >
          <div>
            <div class="mb-2 flex items-center gap-2">
              <Icon
                icon="lucide:phone"
                class="size-5 text-primary"
                aria-hidden="true"
              />
              <h3 class="text-lg font-bold">Escríbenos o llámanos</h3>
            </div>
            <p class="text-base-content/75">
              Pedidos especiales, eventos o dudas sobre tu orden: respondemos
              por WhatsApp.
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href={WHATSAPP}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary rounded-full"
            >
              <Icon icon="mdi:whatsapp" class="size-5" aria-hidden="true" />
              WhatsApp
            </a>
            <a href={PHONE_TEL} class="btn btn-outline rounded-full">
              <Icon
                icon="lucide:phone-call"
                class="size-4"
                aria-hidden="true"
              />
              {PHONE_DISPLAY}
            </a>
          </div>

          <div class="border-t border-base-300 pt-4">
            <h3 class="mb-2 font-semibold">Síguenos</h3>
            <ul class="grid gap-2 sm:grid-cols-3">
              {
                socials.map((social) => (
                  <li>
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex min-h-11 items-center gap-2 rounded-field border border-base-300 px-3 py-2 transition-colors hover:border-primary"
                    >
                      <Icon
                        icon={social.icon}
                        class="size-5 shrink-0"
                        aria-hidden="true"
                      />
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold">
                          {social.label}
                        </span>
                        <span class="block truncate text-xs text-base-content/65">
                          {social.handle}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <StoreHoursCard client:idle headingLevel="h3" />
      </div>
    </section>

    <section
      aria-labelledby="sucursales-title"
      id="sucursales"
      class="scroll-mt-24"
    >
      <h2
        id="sucursales-title"
        class="mb-1 font-display font-bold text-4xl md:text-5xl"
      >
        Nuestras sucursales
      </h2>
      <p class="mb-5 text-base-content/75">
        Encuéntranos en Ahuachapán, El Salvador. Cada sucursal tiene su propio
        WhatsApp para pedidos especiales y dudas.
      </p>
      <StoreLocationsList client:idle variant="maps" />
    </section>
  </div>
</StoreLayout>

<style>
  .about-art {
    width: min(70%, 18rem);
    justify-self: center;
  }

  @media (min-width: 768px) {
    .about-art {
      width: 100%;
      max-width: 22rem;
    }
  }
</style>
