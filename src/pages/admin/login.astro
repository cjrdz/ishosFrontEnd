---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
// Island entries import the component file directly, not a feature barrel:
// Astro bundles the imported module, so a barrel would ship every export.
import AdminLoginForm from "@features/auth/components/AdminLoginForm.svelte";
---

<AdminLayout title="Admin Login - IshosFactory">
  <section class="min-h-[70vh] flex items-center justify-center">
    <AdminLoginForm client:load />
  </section>
</AdminLayout>
