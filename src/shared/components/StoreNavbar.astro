---
import ThemeToggle from "@shared/components/ThemeToggle.svelte";
// Island entries import the component file directly, not a feature barrel:
// Astro bundles the imported module, so a barrel would ship every export.
import StoreCartIcon from "@features/catalog/components/StoreCartIcon.svelte";
import StoreStatusChip from "@features/catalog/components/StoreStatusChip.svelte";
import StoreLogo from "./StoreLogo.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: "/", label: "Inicio" },
  { href: "/menu", label: "Menú" },
  { href: "/about", label: "Nosotros" },
  // Hidden until the store settings say public tracking is on (admin switch).
  { href: "/order/tracking", label: "Seguir mi orden", tracking: true },
];

// "/" only matches itself; other links also match their sub-pages.
const isActive = (href: string) =>
  href === "/"
    ? currentPath === "/"
    : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="store-nav">
  <nav aria-label="Principal" class="store-nav__bar">
    <StoreLogo />

    <ul class="store-nav__links">
      {
        links.map((link) => (
          <li
            data-tracking-link={link.tracking ? "" : undefined}
            hidden={link.tracking}
          >
            <a
              href={link.href}
              class="store-nav__link"
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="store-nav__end">
      <div class="store-nav__status">
        <StoreStatusChip client:idle transition:persist="store-status-wide" />
      </div>
      <StoreCartIcon client:load transition:persist="store-cart-icon" />
      <ThemeToggle client:load />
      <button
        type="button"
        class="store-nav__toggle"
        aria-expanded="false"
        aria-controls="store-nav-panel"
        data-nav-toggle
      >
        <span class="sr-only">Abrir menú de navegación</span>
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="bar bar--top" d="M4 7h16"></path>
          <path class="bar bar--mid" d="M4 12h16"></path>
          <path class="bar bar--bot" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="store-nav-panel" class="store-nav__panel" data-nav-panel hidden>
    <ul>
      {
        links.map((link) => (
          <li
            data-tracking-link={link.tracking ? "" : undefined}
            hidden={link.tracking}
          >
            <a
              href={link.href}
              class="store-nav__panel-link"
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="store-nav__panel-status">
      <StoreStatusChip client:idle transition:persist="store-status-narrow" />
    </div>
  </div>
</header>

<script>
  import { fetchStoreSettings } from "@features/catalog/lib/api";

  // "Seguir mi orden" shows only when the admin turned public tracking on.
  function revealTracking() {
    void fetchStoreSettings()
      .then((settings) => {
        if (!settings.tracking_enabled) return;
        document
          .querySelectorAll<HTMLElement>("[data-tracking-link]")
          .forEach((item) => (item.hidden = false));
      })
      .catch(() => {});
  }

  // Mobile menu: disclosure button + panel. Closes on Escape, on a link tap
  // and when the viewport grows past the breakpoint. Bound per page load
  // because the header is re-rendered by the page router.
  function bindNav() {
    const toggle =
      document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
    if (!toggle || !panel || toggle.dataset.bound) return;
    toggle.dataset.bound = "1";
    const label = toggle.querySelector(".sr-only");

    const setOpen = (open: boolean, focusToggle = false) => {
      toggle.setAttribute("aria-expanded", String(open));
      if (label) {
        label.textContent = open
          ? "Cerrar menú de navegación"
          : "Abrir menú de navegación";
      }
      panel.hidden = !open;
      if (open) panel.querySelector<HTMLElement>("a")?.focus();
      else if (focusToggle) toggle.focus();
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) setOpen(false, true);
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (mq) => {
      if (mq.matches) setOpen(false);
    });
  }

  bindNav();
  revealTracking();
  document.addEventListener("astro:page-load", () => {
    bindNav();
    revealTracking();
  });
</script>

<style>
  /* Kept hidden until public tracking is on (see revealTracking). */
  [data-tracking-link][hidden] {
    display: none !important;
  }

  .store-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-base-200) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-base-300);
  }
  .store-nav__bar {
    max-width: 75rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.75rem 1.75rem;
    padding: 0.5rem 1rem;
    min-height: 4rem;
  }
  .store-nav__links {
    display: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .store-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-base-content);
    position: relative;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .store-nav__link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 6px;
    height: 3px;
    border-radius: 3px;
    background: var(--brand-rays-a);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-panel) var(--ease-out);
  }
  [data-theme="night"] .store-nav__link::after {
    background: var(--color-primary);
  }
  .store-nav__link:hover::after,
  .store-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .store-nav__link[aria-current="page"] {
    color: var(--brand-head);
    font-weight: 700;
  }
  .store-nav__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .store-nav__status {
    display: none;
    margin-right: 0.5rem;
  }
  .store-nav__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--color-base-300);
    background: transparent;
    color: var(--brand-head);
    cursor: pointer;
  }
  .store-nav__toggle:focus-visible,
  .store-nav__link:focus-visible,
  .store-nav__panel-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .bar {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform var(--dur-panel) var(--ease-out),
      opacity var(--dur-fast);
  }
  .store-nav__toggle[aria-expanded="true"] .bar--top {
    transform: translateY(5px) rotate(45deg);
  }
  .store-nav__toggle[aria-expanded="true"] .bar--mid {
    opacity: 0;
  }
  .store-nav__toggle[aria-expanded="true"] .bar--bot {
    transform: translateY(-5px) rotate(-45deg);
  }
  .store-nav__panel {
    border-top: 1px solid var(--color-base-300);
    padding: 0.5rem 1rem 1rem;
  }
  .store-nav__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .store-nav__panel-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.75rem;
    border-radius: 0.75rem;
    font-weight: 500;
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--color-base-content);
  }
  .store-nav__panel-link[aria-current="page"] {
    background: var(--brand-pink-tint);
    color: var(--brand-head);
    font-weight: 700;
  }
  .store-nav__panel-status {
    padding: 0.75rem 0.75rem 0;
  }
  .store-nav__panel-status:empty {
    display: none;
  }

  @media (min-width: 768px) {
    .store-nav__links {
      display: flex;
    }
    .store-nav__status {
      display: block;
    }
    .store-nav__toggle,
    .store-nav__panel {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .store-nav__link::after {
      transition: none;
    }
  }
</style>
