# Local development: copy to .env.development (loaded by `astro dev` only).
# Do NOT create a plain .env: `pnpm deploy` builds locally and Vite would inline
# PUBLIC_API_BASE_URL from it, overriding the production value in wrangler.jsonc.
PUBLIC_API_BASE_URL=backend URL here
PUBLIC_AUTH_COOKIE_TTL_HOURS=24
PUBLIC_ADMIN_IMAGE_UPLOAD_MAX_MB=15
# Required in production. Used to sign the short-lived session cache cookie in middleware.
SESSION_CACHE_SECRET=change-me-to-a-long-random-secret

# Shared with the backend (BFF_SHARED_SECRET on Railway). Lets the backend
# trust the X-Client-IP header for per-customer rate limits. Read at runtime;
# set on Cloudflare with: wrangler secret put BFF_SHARED_SECRET
BFF_SHARED_SECRET=
